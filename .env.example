# SuperAgent 团队统一配置（Python 3.12）
# 将本文件复制为 .env，并在本机填写真实 API Key；禁止提交 .env。

# 复杂规划与推理
REASONING_API_KEY=
REASONING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_MODEL=qwen3.5-27b

# 普通任务
BASIC_API_KEY=
BASIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BASIC_MODEL=qwen3.5-27b

# 代码任务
CODE_API_KEY=
CODE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CODE_MODEL=deepseek-v4-flash

# 视觉任务
VL_API_KEY=
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen3.5-27b

# 本地远程 Agent Demo
REMOTE_API_KEY=
REMOTE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REMOTE_MODEL=qwen3.5-27b
REMOTE_LLM_TEMPERATURE=0.1
REMOTE_LLM_MAX_TOKENS=2000
REMOTE_EXTRACTION_TIMEOUT=30
REMOTE_REPORT_LLM_TIMEOUT=120
REMOTE_REPORT_TOOL_TIMEOUT=150

# 应用开关
APP_ENV=development
DEBUG=false
ANONYMIZED_TELEMETRY=false
USE_BROWSER=false
USE_MCP_TOOLS=false
MCP_AGENT=false
S_ABAC_ENABLED=false

# 意图识别：rule / hybrid / semantic。hybrid 默认复用 BASIC_* 模型配置。
INTENT_RECOGNITION_MODE=hybrid
INTENT_RULE_STRONG_THRESHOLD=0.82
INTENT_SEMANTIC_ACCEPT_THRESHOLD=0.72
INTENT_SEMANTIC_HIGH_RISK_THRESHOLD=0.85
INTENT_AGREEMENT_BONUS=0.06
INTENT_CONFLICT_THRESHOLD=0.75
INTENT_SEMANTIC_TIMEOUT_SECONDS=20

# 搜索服务（可选；未配置时页面会自动禁用搜索）
TAVILY_API_KEY=
JINA_API_KEY=
